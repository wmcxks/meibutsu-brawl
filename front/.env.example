# ============================================================
# H5 前端环境变量（Vite）
# 复制为 .env 或按构建环境提供 .env.production / .env.line 等
# ============================================================

# 后端 API 地址（开发默认 http://localhost:8089）
VITE_API_BASE_URL=http://localhost:8089

# 发布目标平台：web | line
# web  -> WebAdapter（游客 UUID 静默登录）
# line -> LineAdapter（LINE LIFF，需配 VITE_LIFF_ID）
VITE_TARGET_PLATFORM=web

# LINE LIFF App ID（仅 line 平台需要）
VITE_LIFF_ID=

# H3：资源 CDN 前缀（构建产物 base；如 https://cdn.example.com/meibutsu-h5/）
# 留空 = 相对路径（与后端同域部署 / 本地开发）
VITE_CDN_BASE=

# H3：客户端版本（服务端 app.min_client_ver 强更判定的比较基准）
# 建议发布时注入（如 git describe --tags 或 package.json version）
VITE_APP_VERSION=0.0.0
