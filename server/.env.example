# 环境变量配置（开发环境）

# 服务监听地址
SERVER_HOST=0.0.0.0
SERVER_PORT=8089

# MySQL（本项目与金毛大战波斯猫共用一个 MySQL 实例，表名统一用 hd_ 前缀）
# 本地：golden_vs_persian   线上：ai_golden_vs_persian
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=golden_vs_persian

# LINE（LIFF Channel ID，校验 id_token 的 aud）
LINE_CHANNEL_ID=

# JWT
JWT_SECRET=please-change-me-in-production
JWT_EXPIRE_HOURS=168

# 防刷签名盐值（必须与前端 src/api/request.ts 的 SIGN_SALT 一致）
ANTI_CHEAT_SALT=Hd@2026!AntiCheat#7xQz$K9vM
ANTI_CHEAT_SKEW_SECONDS=60

# Redis（分段参数连接，便于切换不同 Redis 提供方）
# Upstash 示例：
#   REDIS_USERNAME=default
#   REDIS_HOST=quality-oyster-xxx.upstash.io
#   REDIS_PORT=6379
#   REDIS_PASSWORD=<完整密码>
#   REDIS_DB=0
# 说明：host 含 .upstash.io 时自动启用 TLS（rediss://）；
# 其他云 Redis 需要 TLS 时加 REDIS_SSL=true
REDIS_USERNAME=default
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# 防刷（服务端行为校验）
SESSION_TTL_SECONDS=3600
SUBMIT_RATE_LIMIT_PER_MINUTE=3
MIN_CLEAR_TIME_SECONDS=3.0
CLEAR_TIME_TOLERANCE_SECONDS=5.0

# 奖励发放（C1）
REWARD_DAILY_CAP_PER_PLACEMENT=10
REWARD_NONCE_TTL_SECONDS=604800

# 管理后台（G1；X-Admin-Token 请求头鉴权，留空 = 后台整体关闭）
ADMIN_TOKEN=

# 阿里云 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com/

# 线上服务器 SSH（运维脚本远程执行用）
SSH_HOST=
SSH_USER=
SSH_PASSWORD=

# 线上 MySQL root 凭据（phpMyAdmin 登录、运维脚本直连）
MYSQL_ROOT_HOST=
MYSQL_ROOT_USER=
MYSQL_ROOT_PASSWORD=
MYSQL_ROOT_DATABASE=

# F3 监控告警（服务端请求级）
# 单请求耗时超过该毫秒数 → 慢请求告警；单分钟 5xx ≥ 该值 → 错误率告警
ALERT_SLOW_MS=2000
ALERT_ERROR_PER_MINUTE=10
# 可选：告警推送 Webhook（POST JSON {msg_type:text, text:{content}}）
ALERT_WEBHOOK_URL=

# C3 真实支付渠道（占位；未配置时回调返回 501，需商务资质后启用）
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=

# H3 强更兜底（正式值写 hd_configs 的 app.min_client_ver / app.latest_url 下发）
MIN_CLIENT_VER=

# F3 可选错误监控（Sentry；空 = 不启用。安装依赖：pip install -e 'server[monitoring]'）
SENTRY_DSN=
# 运行环境标识（dev / staging / prod），随错误上报上下文标记
ENV_NAME=dev
